# Environment & Secrets Configuration (copy to .env for staging/production overrides)
ENV=local
SERVICE_NAME=machine-simulator

# Hot Edge Object Buffer (RustFS S3-compatible)
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
S3_RAW_BUCKET=machine-raw
S3_QUARANTINE_BUCKET=machine-quarantine
S3_ML_BUCKET=machine-ml

# Cold Lakehouse Object Storage (Garage S3 - Separate Cold Tier)
S3_COLD_ENDPOINT=http://garage-cold:3900
GARAGE_ACCESS_KEY=garageadmin
GARAGE_SECRET_KEY=garageadmin
GARAGE_RPC_SECRET=4d3f1d8c9a2b7e6f0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2a3b
S3_COLD_BUCKET=machine-ml-cold

# Hot Operational PostgreSQL 16 Feature Mart & BA Views
POSTGRES_USER=mlops
POSTGRES_PASSWORD=mlops
POSTGRES_DB=machine_logs

# Grafana Provisioning Admin
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Simulator Throughput & Multi-Domain Fleet Topology
SIM_RATE_HZ=2.0
SIM_ROTATE_MAX_LINES=2000
SIM_MACHINES=M-01:line-01:plc-controller,M-02:line-01:cnc-mill,M-03:line-02:gas-flow-meter,M-04:line-03:power-meter

# Incremental Dataset Builder, Compaction & Retention
BUILDER_WINDOW_MINUTES=5
BUILDER_WATERMARK_LOOKBACK_MIN=15
BUILDER_HORIZON_WINDOWS=1
BUILDER_WATCH_INTERVAL_SEC=30
BUILDER_PARTITION_LAYOUT=domain/dt
BUILDER_PARQUET_COMPRESSION=zstd
BUILDER_SEGMENT_RETENTION_HOURS=48
