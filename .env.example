# Industrial Telemetry & Edge Gateway Platform — Environment Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Live Persistence (Control Plane + ML Feature Mart + BA SQL Views)
# Leave empty in local dev to run with automatic atomic .state/*.json fallback.
# In on-premise / production, point to your PostgreSQL 16+ instance:
# DATABASE_URL=postgres://mlops:<strong-password>@localhost:5432/machine_logs
DATABASE_URL=
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# API Security & Multi-Scope Authentication
# Authentication is ALWAYS enforced when NODE_ENV=production (this flag cannot disable it).
# Outside production, set API_ENFORCE_AUTH=true to require Bearer / X-API-Key / X-Gateway-Token on all routes.
API_ENFORCE_AUTH=false
API_ADMIN_TOKEN=
API_READ_TOKEN=
EDGE_GATEWAY_TOKEN=
# Master AES-256-GCM encryption key for persisted secrets (SMTP password, webhook signing secret).
# Generate in production with: openssl rand -hex 32
# Required in production (boot fails without it). In local dev, if left empty, an auto-generated
# 0600 key is stored in .state/.master.key
SECRETS_ENCRYPTION_KEY=

# Network & Probe Hardening
# Optional comma-separated CORS allowlist (empty = same-origin only)
CORS_ORIGIN=
# Set true only when probing a local PLC simulator on 127.0.0.1 / localhost
ALLOW_LOOPBACK_PROBE=false

# Edge Collector OT Field Driver Credentials (used by Python edge_gateway.collector)
EDGE_OPCUA_USERNAME=
EDGE_OPCUA_PASSWORD=
EDGE_OPCUA_CERT_PATH=
EDGE_OPCUA_KEY_PATH=
EDGE_MQTT_USERNAME=
EDGE_MQTT_PASSWORD=
EDGE_MQTT_TLS=false
EDGE_MQTT_CA_CERT=
EDGE_HTTP_METER_TOKEN=

# Alerting Channels (Email via SMTP / Mailpit + HTTP Webhook)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alerts@telemetry.plant.local
ALERT_EMAIL_TO=maintenance@plant.local
MAILPIT_UI_URL=http://localhost:8025
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=

# User RBAC & Optional Reverse-Proxy OIDC Trust
AUTH_ADMIN_EMAIL=admin@plant.local
# Required in production (min 12 chars). Outside production a random password is generated
# and printed once at first boot when left empty.
AUTH_ADMIN_PASSWORD=
# Demo operator/viewer accounts are seeded only outside production and only when set to true.
AUTH_SEED_DEMO_USERS=false
TRUST_PROXY_AUTH_HEADERS=false
# Express trust proxy: number of hops, true/false, or trusted subnets (e.g. loopback,10.0.0.0/8).
# Set it when running behind an ingress/reverse proxy so rate limits and audit IPs see real clients.
TRUST_PROXY=false

# Observability, Structured JSON Logging & Site Tagging (Open Core single-plant default)
PLANT_SITE_ID=plant-01
LOG_LEVEL=info
METRICS_AUTH_REQUIRED=false

# Air-Gapped / Offline Plant Network Override
# Optional internal URL hosting @scalar/api-reference standalone JS bundle for /api/docs
# Leave empty to use the default Scalar CDN.
SCALAR_CDN_URL=

# Docker Compose stack (root docker-compose.yml, production mode): required before `docker compose up`.
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
# Internal services (PostgreSQL, Mailpit, Prometheus, Grafana) listen on 127.0.0.1 by default.
# Set a specific address (e.g. the server LAN IP) only if they must be reachable from other hosts.
PLCLAKE_BIND_ADDR=127.0.0.1
