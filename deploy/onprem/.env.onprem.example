# PLCLake on-premise stack (deploy/onprem/docker-compose.yml)
# Copy to .env and fill the REQUIRED values: `docker compose up` refuses to start without them.

# ---- Required ---------------------------------------------------------------
# Initial administrator (at least 12 characters).
AUTH_ADMIN_PASSWORD=
# 64 hex characters: openssl rand -hex 32
SECRETS_ENCRYPTION_KEY=
# PostgreSQL password (used by postgres, pgbouncer, backups and the app).
POSTGRES_PASSWORD=
# Only needed with the observability profile (--profile observability).
GRAFANA_ADMIN_PASSWORD=

# ---- Image & site -----------------------------------------------------------
PLCLAKE_IMAGE=ghcr.io/salvo8519/plclake:1.0.0
# Public address served by Caddy (e.g. telemetry.plant.example.com for automatic TLS, or :80).
PLCLAKE_SITE_ADDRESS=:80
PLANT_SITE_ID=plant-01
AUTH_ADMIN_EMAIL=admin@plant.local
LOG_LEVEL=info
HTTP_PORT=80
HTTPS_PORT=443
PLCLAKE_MEM_LIMIT=1024M

# ---- Database ----------------------------------------------------------------
POSTGRES_USER=plclake
POSTGRES_DB=plclake_telemetry
DATABASE_POOL_MAX=20
PGBOUNCER_POOL_SIZE=25
PGBOUNCER_MAX_CLIENT_CONN=400
BACKUP_INTERVAL_SEC=86400
BACKUP_RETENTION_DAYS=14

# ---- Security -----------------------------------------------------------------
# Authentication is always enforced in production; this flag cannot disable it.
API_ENFORCE_AUTH=true
# One hop (Caddy). Change only if another proxy sits in front of Caddy.
TRUST_PROXY=1
METRICS_AUTH_REQUIRED=true
CORS_ORIGIN=

# ---- Alerts (SMTP) -----------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alerts@plant.local
ALERT_EMAIL_TO=maintenance@plant.local

# ---- Observability & air-gapped -------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_PORT=3001
# Internal URL of the Scalar bundle for offline API docs (empty = public CDN).
SCALAR_CDN_URL=
